# --- Saleor App SDK runtime config ---
# Public URL the app is reachable at from Saleor (used in the manifest).
# In production this is the Vercel deployment URL or your custom domain.
APP_API_BASE_URL=http://localhost:3110
# Optional. URL the Saleor Dashboard uses to load the app's iframe.
# APP_IFRAME_BASE_URL=

# Restrict which Saleor instance may install the app. Empty = allow any (dev only).
# SALEOR_API_URL=https://api.infinitybiolabs.com/graphql/

# --- App Persistence Layer (where the SALEOR install token lives) ---
# `file` for local dev only. Use `env` on Vercel (per the shipstation convention —
# avoids UpstashAPL cross-app token collisions).
APL=file
# Path for FileAPL when APL=file. Defaults to .saleor-app-auth.json.
# APL_FILE_PATH=
# Required when APL=env. From Saleor Dashboard → Apps → app → Tokens.
# SALEOR_APP_TOKEN=
# SALEOR_APP_ID=

# --- QuickBooks Online OAuth (Intuit Developer app) ---
# sandbox while testing; production once live (changes the API host).
QBO_ENVIRONMENT=sandbox
# From developer.intuit.com → your app → Keys & credentials.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in the Intuit app.
QBO_REDIRECT_URI=http://localhost:3110/api/qbo/callback
# QBO_SCOPES=com.intuit.quickbooks.accounting
# QBO_MINOR_VERSION=73
# Optional. Defaults to `sandbox` or `production`; set when sharing one Redis DB
# across multiple deployments.
# QBO_STORE_NAMESPACE=infinitybio-prod

# --- QuickBooks mapping (Phase-1 defaults) ---
# QBO_CUSTOMER_NAME=Online Sales
# QBO_ITEM_PEPTIDES=Peptides
# QBO_ITEM_SUPPLIES=Supplies
# QBO_INCOME_ACCOUNT=Sales of Product Income
# Optional bank/clearing account to deposit receipts into (e.g. a Stripe clearing
# account) so a separate Stripe→QBO payout reconciliation nets out. Omit → Undeposited Funds.
# QBO_DEPOSIT_ACCOUNT=Stripe Clearing
# Saleor category slug that books to the "Supplies" income item.
# QBO_SUPPLIES_CATEGORY_SLUG=supplies
# Shipping: leave off until shipping is actually charged in Saleor. When "true",
# shipping is booked on its own SalesReceipt line to a dedicated income account
# (re-run /api/qbo/bootstrap after flipping it to create the item/account).
# QBO_SHIPPING_ENABLED=false
# QBO_ITEM_SHIPPING=Shipping
# QBO_SHIPPING_INCOME_ACCOUNT=Shipping Income

# --- Upstash Redis (QBO OAuth tokens + Saleor-order→QBO-doc id-map) ---
# From upstash.com → your Redis DB → REST API. REQUIRED on Vercel: the QBO refresh
# token rotates on every refresh and must be written back at runtime.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret gating the admin endpoints (connect/bootstrap/status/errors/reset).
# Min 16 chars (32+ recommended); compared in constant time. Pass as ?secret= or
# the x-admin-secret header. Generate with: openssl rand -hex 32
QBO_ADMIN_SECRET=

# --- Logging ---
LOG_LEVEL=info
